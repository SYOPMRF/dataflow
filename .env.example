# PostgreSQL para el entorno Docker de DataFlow
# Credenciales administrativas de la instancia
POSTGRES_DB=dataflow
POSTGRES_USER=dataflow_app
POSTGRES_PASSWORD=replace_with_a_strong_password

# Credenciales exclusivas del backend
APP_DB_USER=dataflow_runtime
APP_DB_PASSWORD=replace_with_a_different_strong_password

# JWT: reemplazar por un secreto aleatorio seguro antes de iniciar
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRATION_MS=3600000

# MinIO: almacenamiento S3-compatible local
MINIO_ROOT_USER=replace_with_minio_user
MINIO_ROOT_PASSWORD=replace_with_a_strong_minio_password

# Credenciales exclusivas del backend para el bucket dataflow-files
FILE_STORAGE_S3_ACCESS_KEY=replace_with_dataflow_s3_user
FILE_STORAGE_S3_SECRET_KEY=replace_with_a_strong_dataflow_s3_password
